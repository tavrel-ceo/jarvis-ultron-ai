# A.R.I.S. AI provider
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.35

# Optional web search
BRAVE_SEARCH_API_KEY=

# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Obrigatório em produção: token aleatório longo (não usar chave de IA)
ARIS_ACCESS_TOKEN=
# Ferramentas locais permanecem desativadas em produção
ARIS_ENABLE_LOCAL_TOOLS=false
# Configuração opcional multimodelo (JSON de provedores; somente no servidor)
ARIS_MODELS_JSON=[]
