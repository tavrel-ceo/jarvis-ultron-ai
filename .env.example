# A.R.I.S. — configuração de IA
# Compatibilidade: se ARIS_MODELS não estiver definido, a A.R.I.S. usa o provedor único abaixo.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.35
AI_MODEL_TIMEOUT_MS=15000

# Orquestração Multi-IA
# Liste os identificadores dos modelos habilitados separados por vírgula.
# Cada modelo pode apontar para qualquer API compatível com /chat/completions.
# Exemplo: ARIS_MODELS=modelo_a,modelo_b
ARIS_MODELS=

# Exemplo de configuração por modelo:
# ARIS_MODEL_MODELO_A_API_KEY=
# ARIS_MODEL_MODELO_A_BASE_URL=https://api.exemplo.com/v1
# ARIS_MODEL_MODELO_A_MODEL=nome-do-modelo
# ARIS_MODEL_MODELO_A_ROLES=analise,critica,verificacao,alternativa,sintese
# ARIS_MODEL_MODELO_A_TIMEOUT_MS=15000
# ARIS_MODEL_MODELO_A_WEIGHT=1
# ARIS_MODEL_MODELO_A_ENABLED=true

# Pesquisa web opcional
BRAVE_SEARCH_API_KEY=

# Orçamento de contexto
AI_CONTEXT_BUDGET=12000
AI_SYSTEM_BUDGET=1800
AI_MESSAGE_BUDGET=900

# Ferramentas: low | medium | high | critical
TOOL_AUTO_APPROVAL=medium

# Servidor
PORT=8787
CORS_ORIGIN=http://localhost:5173
